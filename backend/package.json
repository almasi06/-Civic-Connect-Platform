{
  "name": "civic-connect-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
"scripts": {
  "dev": "tsx watch --env-file=.env server/index.ts",
  "build": "tsc",
  "start": "node --env-file=.env dist/server/index.js",
  "typecheck": "tsc --noEmit",
  "test": "node --env-file=.env node_modules/vitest/vitest.mjs run",
  "test:watch": "node --env-file=.env node_modules/vitest/vitest.mjs"
},
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
